          "description": "MetalsPage",
          "isMain": false,
          "inObjectiveManner": false,
          "shellType": "Local Shell (system Python)",
          "sqlScriptType": "MSSQL",
          "connectionString": "",
          "inputConstructorRouting": {},
          "setterMethodNames": {},
