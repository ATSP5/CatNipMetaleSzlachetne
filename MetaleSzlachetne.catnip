          "fileFormat": "Python",
          "reportDefinition": "",
          "dataSchema": "",
          "interactiveReport": "{\u0022ClassName\u0022:\u0022MetalsPage\u0022,\u0022Title\u0022:\u0022Metale szlachetne \\u2014 prognoza, podatek, inflacja, scenariusze\u0022,\u0022Inputs\u0022:[\u0022analyzer\u0022],\u0022Height\u0022:2700,\u0022KeepAlive\u0022:true,\u0022Markup\u0022:\u0022\\u003Cdiv class=\\u0022mt\\u0022\\u003E\\n  \\u003Ch1\\u003EZ\\u0142oto, srebro, platyna \\u2014 fizycznie, na r\\u0119k\\u0119 i po inflacji\\u003C/h1\\u003E\\n  \\u003Cp class=\\u0022cn-muted\\u0022\\u003EMonety bulionowe i sztabki, kt\\u00F3re osoba prywatna kupi u dealera w Poznaniu albo z wysy\\u0142k\\u0105. Ceny spot z {r.kpis[\\u0022as_of\\u0022]} ({r.kpis[\\u0022price_source\\u0022]}); inflacja: {r.kpis[\\u0022cpi_source\\u0022]}. Prognoza: \\u003Cb\\u003E{r.kpis[\\u0022model\\u0022]}\\u003C/b\\u003E. Ka\\u017Cda kwota \\u201Ena r\\u0119k\\u0119\\u201D jest po mar\\u017Cy dealera, VAT, dyskoncie skupu i podatku.\\u003C/p\\u003E\\n  \\u003Cdiv class=\\u0022cn-row\\u0022\\u003E{button(\\u0022Przywr\\u00F3\\u0107 ustawienia domy\\u015Blne\\u0022, call=\\u0022reset\\u0022, kind=\\u0022secondary\\u0022)}\\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-4\\u0022\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Z\\u0142oto\\u0022, r.kpis[\\u0022gold\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.kpis[\\u0022gold_g\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Srebro\\u0022, r.kpis[\\u0022silver\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.kpis[\\u0022silver_g\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Platyna\\u0022, r.kpis[\\u0022platinum\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.kpis[\\u0022platinum_g\\u0022]} \\u00B7 USD/PLN {r.kpis[\\u0022usdpln\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Inflacja CPI\\u0022, r.kpis[\\u0022cpi\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003EGUS {r.kpis[\\u0022cpi_label\\u0022]} r/r \\u00B7 \\u015Brednio 10 lat {r.kpis[\\u0022cpi10\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Cdiv class=\\u0022cn-grid-3\\u0022\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EZakup\\u003C/h3\\u003E\\n      {radio(\\u0022metal\\u0022, [(\\u0022gold\\u0022, \\u0022Z\\u0142oto\\u0022), (\\u0022silver\\u0022, \\u0022Srebro\\u0022), (\\u0022platinum\\u0022, \\u0022Platyna\\u0022)], label=\\u0022Metal\\u0022)}\\n      {select(\\u0022product\\u0022, product_options, label=\\u0022Produkt\\u0022)}\\n      {slider(\\u0022amount\\u0022, 1000, 500000, step=1000, label=\\u0022Kwota do wydania [z\\u0142]\\u0022, format=\\u0022,.0f\\u0022)}\\n      {slider(\\u0022horizon_months\\u0022, 1, max_months, step=1, label=\\u0022Sprzeda\\u017C za [miesi\\u0119cy]\\u0022, format=\\u0022.0f\\u0022)}\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EKoszty i podatek\\u003C/h3\\u003E\\n      {slider(\\u0022premium\\u0022, 0, 20, step=0.1, label=\\u0022Mar\\u017Ca dealera ponad spot (przed VAT) [%]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022discount\\u0022, 0, 30, step=0.1, label=\\u0022Skup p\\u0142aci mniej ni\\u017C spot o [%]\\u0022, format=\\u0022.1f\\u0022)}\\n      {radio(\\u0022pit_pct\\u0022, [(\\u002212\\u0022, \\u0022PIT 12%\\u0022), (\\u002232\\u0022, \\u0022PIT 32%\\u0022)], label=\\u0022Stawka PIT przy sprzeda\\u017Cy przed 6 mies.\\u0022)}\\n      \\u003Cp class=\\u0022small cn-muted\\u0022\\u003EFizyczny metal: bez podatku po 6 miesi\\u0105cach od ko\\u0144ca miesi\\u0105ca zakupu (od {r.purchase[\\u0022tax_free_from\\u0022]}). Belka 19% \\u2014 obok, do por\\u00F3wnania z metalem \\u201Epapierowym\\u201D.\\u003C/p\\u003E\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EInflacja i wykresy\\u003C/h3\\u003E\\n      {slider(\\u0022cpi_forecast\\u0022, -1, 15, step=0.1, label=\\u0022Za\\u0142o\\u017Cona inflacja na przysz\\u0142o\\u015B\\u0107 [% r/r]\\u0022, format=\\u0022.1f\\u0022)}\\n      {slider(\\u0022history_years\\u0022, 3, 22, step=1, label=\\u0022Historia na wykresach [lata]\\u0022, format=\\u0022.0f\\u0022)}\\n      {toggle(\\u0022chart_real\\u0022, \\u0022Wykres ceny w dzisiejszych z\\u0142otych\\u0022)}\\n      \\u003Cp class=\\u0022small cn-muted\\u0022\\u003EDomy\\u015Blna inflacja = ostatni odczyt GUS. Warto\\u015Bci \\u201Ew dzisiejszych z\\u0142\\u201D dzielone przez wzrost cen do dnia sprzeda\\u017Cy ({r.purchase[\\u0022inflation_loss\\u0022]} si\\u0142y nabywczej).\\u003C/p\\u003E\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  {!warnings_html}\\n\\n  \\u003Ch2\\u003ECo kupujesz\\u003C/h2\\u003E\\n  \\u003Cdiv class=\\u0022cn-grid-4\\u0022\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Kupujesz\\u0022, r.purchase[\\u0022units\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.purchase[\\u0022product\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022P\\u0142acisz\\u0022, r.purchase[\\u0022invested\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003E{r.purchase[\\u0022unit_price\\u0022]} za sztuk\\u0119 \\u00B7 VAT {r.purchase[\\u0022vat\\u0022]} \\u00B7 spot {r.purchase[\\u0022spot\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Sprzedane od razu\\u0022, r.purchase[\\u0022sell_now\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003Ekoszt kupno\\u002Bsprzeda\\u017C {r.purchase[\\u0022round_trip\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n    \\u003Cdiv\\u003E{kpi(\\u0022Cena musi wzrosn\\u0105\\u0107 (realnie)\\u0022, r.purchase[\\u0022needed_real\\u0022])}\\u003Cdiv class=\\u0022kpi-sub\\u0022\\u003Enominalnie {r.purchase[\\u0022needed_nominal\\u0022]} \\u00B7 szansa realnej straty {r.purchase[\\u0022p_real_loss\\u0022]}\\u003C/div\\u003E\\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n  \\u003Cp class=\\u0022small cn-muted\\u0022\\u003E{r.purchase[\\u0022note\\u0022]}. W medianie prognozy wychodzisz na zero nominalnie: \\u003Cb\\u003E{r.purchase[\\u0022breakeven_nominal\\u0022]}\\u003C/b\\u003E, realnie (po inflacji): \\u003Cb\\u003E{r.purchase[\\u0022breakeven_real\\u0022]}\\u003C/b\\u003E.\\u003C/p\\u003E\\n\\n  \\u003Ch2\\u003EWynik po {horizon_months} mies. \\u2014 na r\\u0119k\\u0119 i w dzisiejszych z\\u0142otych\\u003C/h2\\u003E\\n  {table(r.outcome, id=\\u0022outcome\\u0022, filter=False, sortable=False)}\\n\\n  \\u003Ch2\\u003ECena {metal_name}: historia i prognoza\\u003C/h2\\u003E\\n  {plotly(price_fig, height=430, id=\\u0022price\\u0022)}\\n\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv\\u003E\\n      \\u003Ch2\\u003EWarto\\u015B\\u0107 na r\\u0119k\\u0119 w dzisiejszych z\\u0142\\u003C/h2\\u003E\\n      {plotly(value_fig, height=340, id=\\u0022value\\u0022)}\\n    \\u003C/div\\u003E\\n    \\u003Cdiv\\u003E\\n      \\u003Ch2\\u003EMetale a inflacja (indeks 100 = start)\\u003C/h2\\u003E\\n      {chart(\\u0022line\\u0022, r.index_chart, x=\\u0022Miesi\\u0105c\\u0022, y=[\\u0022Z\\u0142oto\\u0022, \\u0022Srebro\\u0022, \\u0022Platyna\\u0022, \\u0022Inflacja (CPI GUS)\\u0022], height=340, mode=\\u0022lines\\u0022, id=\\u0022index\\u0022, y_title=\\u0022indeks\\u0022)}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n\\n  \\u003Ch2\\u003EWszystkie produkty \\u2014 ta sama kwota i horyzont\\u003C/h2\\u003E\\n  {table(r.comparison, id=\\u0022comparison\\u0022, filter=False)}\\n\\n  \\u003Ch2\\u003EAnaliza scenariuszowa \\u2014 co, je\\u015Bli\\u2026\\u003C/h2\\u003E\\n  \\u003Cdiv class=\\u0022cn-grid-2\\u0022\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      {textarea(\\u0022scenario_text\\u0022, label=\\u0022Opisz wydarzenie (po polsku), np. \\u201EChiny atakuj\\u0105 Tajwan\\u201D, \\u201EFed obni\\u017Ca stopy o 1 pp\\u201D, \\u201Estrajk w kopalniach platyny w RPA\\u201D\\u0022)}\\n      {slider(\\u0022severity\\u0022, 0.25, 3, step=0.25, label=\\u0022Si\\u0142a wydarzenia (\\u00D7, 1 = jak przeci\\u0119tnie w historii)\\u0022, format=\\u0022.2f\\u0022)}\\n      {slider(\\u0022persistence\\u0022, 0, 100, step=5, label=\\u0022Ile wp\\u0142ywu zostaje po roku [%]\\u0022, format=\\u0022.0f\\u0022)}\\n      \\u003Cdiv class=\\u0022cn-row\\u0022\\u003E{button(\\u0022Przewiduj wp\\u0142yw\\u0022, call=\\u0022run_scenario\\u0022)} {button(\\u0022Wyczy\\u015B\\u0107 scenariusz\\u0022, call=\\u0022clear_scenario\\u0022, kind=\\u0022secondary\\u0022)}\\u003C/div\\u003E\\n    \\u003C/div\\u003E\\n    \\u003Cdiv class=\\u0022cn-card\\u0022\\u003E\\n      \\u003Ch3\\u003EWynik\\u003C/h3\\u003E\\n      \\u003Cp\\u003E{r.scenario_summary or \\u0022Wpisz wydarzenie i naci\\u015Bnij \\u201EPrzewiduj wp\\u0142yw\\u201D. Lokalny model rozpozna rodzaj wydarzenia, a wp\\u0142yw na ceny wynika z tego, jak metale w z\\u0142otych naprawd\\u0119 reagowa\\u0142y na podobne wydarzenia od 2004 r.\\u0022}\\u003C/p\\u003E\\n      {table(r.scenario_impacts, id=\\u0022impacts\\u0022, filter=False, sortable=False) if r.scenario_impacts else \\u0022\\u0022}\\n      {table(r.scenario_matches, id=\\u0022matches\\u0022, filter=False, sortable=False) if r.scenario_matches else \\u0022\\u0022}\\n    \\u003C/div\\u003E\\n  \\u003C/div\\u003E\\n  {html(\\u0022\\u003Ch3\\u003EPodobne wydarzenia w historii \\u2014 zmiana ceny w z\\u0142 po 1 miesi\\u0105cu, ponad typowy trend\\u003C/h3\\u003E\\u0022) if r.scenario_analogs else \\u0022\\u0022}\\n  {table(r.scenario_analogs, page_size=12, id=\\u0022analogs\\u0022, filter=False) if r.scenario_analogs else \\u0022\\u0022}\\n\\n  \\u003Ch2\\u003EZa\\u0142o\\u017Cenia\\u003C/h2\\u003E\\n  \\u003Cul class=\\u0022small\\u0022\\u003E{!notes_html}\\u003C/ul\\u003E\\n\\u003C/div\\u003E\\n\u0022,\u0022Code\u0022:\u0022import html as html_lib\\n\\nMETAL_COLORS = {\\u0022gold\\u0022: \\u0022#b8860b\\u0022, \\u0022silver\\u0022: \\u0022#7d8287\\u0022, \\u0022platinum\\u0022: \\u0022#4f7396\\u0022}\\nMETAL_GENITIVE = {\\u0022gold\\u0022: \\u0022z\\u0142ota\\u0022, \\u0022silver\\u0022: \\u0022srebra\\u0022, \\u0022platinum\\u0022: \\u0022platyny\\u0022}\\n\\n\\ndef setup(self):\\n    self._scenario = None\\n    self.state.update(self.analyzer.defaults())\\n\\n\\ndef reset(self):\\n    self._scenario = None\\n    self.state.update(self.analyzer.defaults())\\n    self.refresh()\\n\\n\\ndef on_metal_change(self, value):\\n    first = self.analyzer.product_options(value)[0][0]\\n    self.state[\\u0022product\\u0022] = first\\n    self.state.update(self.analyzer.product_defaults(first))\\n\\n\\ndef on_product_change(self, value):\\n    self.state.update(self.analyzer.product_defaults(value))\\n\\n\\ndef run_scenario(self):\\n    text = (self.get(\\u0022scenario_text\\u0022) or \\u0022\\u0022).strip()\\n    if not text:\\n        self.toast(\\u0022Najpierw opisz wydarzenie.\\u0022, \\u0022warning\\u0022)\\n        return\\n    self.toast(\\u0022Analizuj\\u0119 wydarzenie lokalnym modelem\\u2026\\u0022, \\u0022info\\u0022)\\n    self._scenario = self.analyzer.scenario(text, self.get(\\u0022severity\\u0022), self.get(\\u0022persistence\\u0022))\\n    self.refresh()\\n\\n\\ndef clear_scenario(self):\\n    self._scenario = None\\n    self.state[\\u0022scenario_text\\u0022] = \\u0022\\u0022\\n    self.refresh()\\n\\n\\ndef prepare(self):\\n    values = self.values()\\n    result = self.analyzer.evaluate(values, self._scenario)\\n    metal = values[\\u0022metal\\u0022]\\n    return {\\n        \\u0022r\\u0022: result,\\n        \\u0022product_options\\u0022: self.analyzer.product_options(metal),\\n        \\u0022max_months\\u0022: self.analyzer.max_months,\\n        \\u0022metal_name\\u0022: self.METAL_GENITIVE[metal],\\n        \\u0022price_fig\\u0022: self.price_figure(result, metal),\\n        \\u0022value_fig\\u0022: self.value_figure(result),\\n        \\u0022warnings_html\\u0022: \\u0022\\u0022.join(\\u0027\\u003Cp class=\\u0022warn\\u0022\\u003E%s\\u003C/p\\u003E\\u0027 % html_lib.escape(w) for w in result.warnings),\\n        \\u0022notes_html\\u0022: \\u0022\\u0022.join(\\u0022\\u003Cli\\u003E%s\\u003C/li\\u003E\\u0022 % html_lib.escape(n) for n in result.notes),\\n    }\\n\\n\\ndef today_line(self, x):\\n    return {\\u0022type\\u0022: \\u0022line\\u0022, \\u0022xref\\u0022: \\u0022x\\u0022, \\u0022yref\\u0022: \\u0022paper\\u0022, \\u0022x0\\u0022: x, \\u0022x1\\u0022: x, \\u0022y0\\u0022: 0, \\u0022y1\\u0022: 1,\\n            \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#57606a\\u0022, \\u0022width\\u0022: 1.5, \\u0022dash\\u0022: \\u0022dash\\u0022}}\\n\\n\\ndef price_figure(self, result, metal):\\n    c = result.price_chart\\n    color = self.METAL_COLORS[metal]\\n    data = [\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_hist\\u0022], \\u0022y\\u0022: c[\\u0022y_hist\\u0022], \\u0022name\\u0022: \\u0022Historia (\\u015Brednia mies.)\\u0022,\\n         \\u0022line\\u0022: {\\u0022color\\u0022: color, \\u0022width\\u0022: 2}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_fc\\u0022], \\u0022y\\u0022: c[\\u0022q90\\u0022], \\u0022line\\u0022: {\\u0022width\\u0022: 0},\\n         \\u0022hoverinfo\\u0022: \\u0022skip\\u0022, \\u0022showlegend\\u0022: False},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_fc\\u0022], \\u0022y\\u0022: c[\\u0022q10\\u0022], \\u0022name\\u0022: \\u0022Prognoza 10\\u201390%\\u0022,\\n         \\u0022fill\\u0022: \\u0022tonexty\\u0022, \\u0022fillcolor\\u0022: \\u0022rgba(130,80,223,0.13)\\u0022, \\u0022line\\u0022: {\\u0022width\\u0022: 0}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_fc\\u0022], \\u0022y\\u0022: c[\\u0022q76\\u0022], \\u0022line\\u0022: {\\u0022width\\u0022: 0},\\n         \\u0022hoverinfo\\u0022: \\u0022skip\\u0022, \\u0022showlegend\\u0022: False},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_fc\\u0022], \\u0022y\\u0022: c[\\u0022q24\\u0022], \\u0022name\\u0022: \\u0022Prognoza 24\\u201376%\\u0022,\\n         \\u0022fill\\u0022: \\u0022tonexty\\u0022, \\u0022fillcolor\\u0022: \\u0022rgba(130,80,223,0.28)\\u0022, \\u0022line\\u0022: {\\u0022width\\u0022: 0}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_fc\\u0022], \\u0022y\\u0022: c[\\u0022q50\\u0022], \\u0022name\\u0022: \\u0022Mediana prognozy\\u0022,\\n         \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#8250df\\u0022, \\u0022width\\u0022: 2}},\\n    ]\\n    if \\u0022baseline\\u0022 in c:\\n        data.append({\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: c[\\u0022x_fc\\u0022], \\u0022y\\u0022: c[\\u0022baseline\\u0022],\\n                     \\u0022name\\u0022: \\u0022Mediana bez scenariusza\\u0022, \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#57606a\\u0022, \\u0022width\\u0022: 1.5, \\u0022dash\\u0022: \\u0022dot\\u0022}})\\n    return {\\u0022data\\u0022: data, \\u0022layout\\u0022: {\\n        \\u0022margin\\u0022: {\\u0022l\\u0022: 70, \\u0022r\\u0022: 20, \\u0022t\\u0022: 10, \\u0022b\\u0022: 40}, \\u0022hovermode\\u0022: \\u0022x unified\\u0022,\\n        \\u0022yaxis\\u0022: {\\u0022title\\u0022: {\\u0022text\\u0022: c[\\u0022unit\\u0022]}, \\u0022tickformat\\u0022: \\u0022,.0f\\u0022},\\n        \\u0022legend\\u0022: {\\u0022orientation\\u0022: \\u0022h\\u0022, \\u0022y\\u0022: -0.15}, \\u0022shapes\\u0022: [self.today_line(c[\\u0022today\\u0022])],\\n        \\u0022annotations\\u0022: [{\\u0022x\\u0022: c[\\u0022today\\u0022], \\u0022y\\u0022: 1, \\u0022xref\\u0022: \\u0022x\\u0022, \\u0022yref\\u0022: \\u0022paper\\u0022, \\u0022text\\u0022: \\u0022dzi\\u015B\\u0022,\\n                         \\u0022showarrow\\u0022: False, \\u0022xanchor\\u0022: \\u0022left\\u0022, \\u0022yanchor\\u0022: \\u0022top\\u0022, \\u0022font\\u0022: {\\u0022color\\u0022: \\u0022#57606a\\u0022}}],\\n        \\u0022paper_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022, \\u0022plot_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022}}\\n\\n\\ndef value_figure(self, result):\\n    rows = result.value_path\\n    x = [row[\\u0022Miesi\\u0105c\\u0022] for row in rows]\\n    data = [\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022p90\\u0022] for r in rows], \\u0022line\\u0022: {\\u0022width\\u0022: 0},\\n         \\u0022hoverinfo\\u0022: \\u0022skip\\u0022, \\u0022showlegend\\u0022: False},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022p10\\u0022] for r in rows], \\u0022name\\u0022: \\u002210\\u201390%\\u0022,\\n         \\u0022fill\\u0022: \\u0022tonexty\\u0022, \\u0022fillcolor\\u0022: \\u0022rgba(31,111,235,0.15)\\u0022, \\u0022line\\u0022: {\\u0022width\\u0022: 0}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022mediana\\u0022] for r in rows], \\u0022name\\u0022: \\u0022mediana (dzisiejsze z\\u0142)\\u0022,\\n         \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#1f6feb\\u0022, \\u0022width\\u0022: 2}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022mediana nominalnie\\u0022] for r in rows],\\n         \\u0022name\\u0022: \\u0022mediana nominalnie\\u0022, \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#1f6feb\\u0022, \\u0022width\\u0022: 1, \\u0022dash\\u0022: \\u0022dot\\u0022}},\\n        {\\u0022type\\u0022: \\u0022scatter\\u0022, \\u0022mode\\u0022: \\u0022lines\\u0022, \\u0022x\\u0022: x, \\u0022y\\u0022: [r[\\u0022Wp\\u0142acone\\u0022] for r in rows], \\u0022name\\u0022: \\u0022wydane\\u0022,\\n         \\u0022line\\u0022: {\\u0022color\\u0022: \\u0022#24292f\\u0022, \\u0022width\\u0022: 1.5, \\u0022dash\\u0022: \\u0022dash\\u0022}},\\n    ]\\n    return {\\u0022data\\u0022: data, \\u0022layout\\u0022: {\\n        \\u0022margin\\u0022: {\\u0022l\\u0022: 70, \\u0022r\\u0022: 20, \\u0022t\\u0022: 10, \\u0022b\\u0022: 40}, \\u0022hovermode\\u0022: \\u0022x unified\\u0022,\\n        \\u0022yaxis\\u0022: {\\u0022title\\u0022: {\\u0022text\\u0022: \\u0022z\\u0142 na r\\u0119k\\u0119\\u0022}, \\u0022tickformat\\u0022: \\u0022,.0f\\u0022}, \\u0022legend\\u0022: {\\u0022orientation\\u0022: \\u0022h\\u0022, \\u0022y\\u0022: -0.2},\\n        \\u0022paper_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022, \\u0022plot_bgcolor\\u0022: \\u0022rgba(0,0,0,0)\\u0022}}\\n\u0022,\u0022Style\u0022:\u0022.mt h1 { margin-bottom: 4px; }\\n.mt h2 { margin-top: 26px; }\\n.mt .small { font-size: 12px; }\\n.mt .kpi-sub { font-size: 12px; color: var(--cn-muted, #6e7781); margin-top: 4px; }\\n.mt .cn-card h3 { margin-top: 0; }\\n.mt .warn { color: #9a6700; background: rgba(212,167,44,0.15); padding: 6px 10px; border-radius: 6px; }\\n\u0022,\u0022SampleData\u0022:\u0022\u0022,\u0022Actions\u0022:[]}",
